# Python
.venv/
__pycache__/
*.py[cod]

# Obsidian Vault (repo-root only -- anchored with a leading slash so
# this does not also match core/memory/ or tests/memory/, the real
# Memory Layer introduced in Build Phase 14; an unanchored "memory/"
# matches a directory of that name at ANY depth, which silently
# shadowed both of those from git entirely until this fix)
/memory/

# ECC is a separate Git repository
ecc/

# Secrets
.env
.env.*
!.env.example
!.env.local.example

# Model/provider config (core/llm/model_config.py, Build Phase 18):
# this file never contains a real API key -- only the *name* of the
# environment variable to read one from -- but it IS deployment-
# specific (which model/provider a given real business project points
# at), so it is not tracked; only the template is.
config/model_config.json

# Logs
*.log

# Security audit log: generated at runtime (including on every test run,
# since the test suite exercises the real AuditLogger against the default
# path). It must never be a tracked, ever-growing source file.
logs/security/*.jsonl

# OS
.DS_Store
Thumbs.db